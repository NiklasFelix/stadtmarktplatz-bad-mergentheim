# Kopieren nach .env und anpassen
# Geheimnis zum Signieren der Login-Tokens - in Produktion unbedingt aendern
JWT_SECRET=changeme-local-dev-jwt-secret

# "openai" fuer echte semantische Matches (erfordert OPENAI_API_KEY),
# "mock" fuer lokales Testen ohne API-Key/Netzwerk
EMBEDDING_PROVIDER=mock
OPENAI_API_KEY=
